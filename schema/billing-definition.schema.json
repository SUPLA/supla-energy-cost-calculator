{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://supla.org/schema/energy-cost/billing-definition-v1.json",
  "title": "SUPLA Energy Cost Billing Definition",
  "type": "object",
  "required": [
    "version",
    "currency",
    "periods"
  ],
  "properties": {
    "version": {
      "const": 1
    },
    "currency": {
      "type": "string",
      "minLength": 3,
      "maxLength": 3
    },
    "timezone": {
      "type": "string",
      "default": "UTC"
    },
    "periods": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/period"
      }
    },
    "billingCycle": {
      "$ref": "#/$defs/billingCycle"
    },
    "billingCycles": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/billingCyclePeriod"
      }
    }
  },
  "additionalProperties": false,
  "allOf": [
    {
      "not": {
        "required": ["billingCycle", "billingCycles"]
      }
    }
  ],
  "$defs": {
    "period": {
      "type": "object",
      "required": [
        "components"
      ],
      "properties": {
        "validFrom": {
          "type": [
            "string",
            "null"
          ],
          "format": "date-time"
        },
        "validTo": {
          "type": [
            "string",
            "null"
          ],
          "format": "date-time"
        },
        "components": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/component"
          }
        }
      },
      "additionalProperties": false
    },
    "component": {
      "type": "object",
      "required": [
        "id",
        "category",
        "quantity",
        "rate"
      ],
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1
        },
        "category": {
          "type": "string",
          "minLength": 1
        },
        "quantity": {
      "oneOf": [
        {
          "type": "object",
          "required": [
            "type"
          ],
          "properties": {
            "type": {
              "enum": [
                "ACTIVE_ENERGY_IMPORT",
                "ACTIVE_ENERGY_EXPORT",
                "ACTIVE_ENERGY_BALANCED_IMPORT",
                "ACTIVE_ENERGY_BALANCED_EXPORT",
                "REACTIVE_ENERGY_IMPORT",
                "REACTIVE_ENERGY_EXPORT"
              ]
            }
          },
          "additionalProperties": false
        },
        {
          "type": "object",
          "required": [
            "type",
            "strategy",
            "periodInMinutes"
          ],
          "properties": {
            "type": {
              "const": "ACTIVE_ENERGY_IMPORT"
            },
            "strategy": {
              "enum": [
                "IMPORT_MINUS_EXPORT",
                "IMPORT_MINUS_EXPORT_CAP_ZERO"
              ]
            },
            "periodInMinutes": {
              "type": "integer",
              "minimum": 1
            }
          },
          "additionalProperties": false
        },
        {
          "type": "object",
          "required": [
            "type",
            "period"
          ],
          "properties": {
            "type": {
              "const": "PERIOD"
            },
            "period": {
              "enum": [
                "DAY",
                "WEEK",
                "MONTH",
                "YEAR",
                "BILLING_PERIOD"
              ]
            },
            "prorate": {
              "type": "boolean",
              "default": false
            }
          },
          "additionalProperties": false
        }
      ]
    },
    "selector": {
          "$ref": "#/$defs/selector"
        },
        "rate": {
          "$ref": "#/$defs/rate"
        }
      },
      "additionalProperties": false
    },
    "quantity": {
      "oneOf": [
        {
          "type": "object",
          "required": [
            "type"
          ],
          "properties": {
            "type": {
              "enum": [
                "ACTIVE_ENERGY_IMPORT",
                "ACTIVE_ENERGY_EXPORT",
                "ACTIVE_ENERGY_BALANCED_IMPORT",
                "ACTIVE_ENERGY_BALANCED_EXPORT",
                "REACTIVE_ENERGY_IMPORT",
                "REACTIVE_ENERGY_EXPORT"
              ]
            }
          },
          "additionalProperties": false
        },
        {
          "type": "object",
          "required": [
            "type",
            "period"
          ],
          "properties": {
            "type": {
              "const": "PERIOD"
            },
            "period": {
              "enum": [
                "DAY",
                "WEEK",
                "MONTH",
                "YEAR",
                "BILLING_PERIOD"
              ]
            },
            "prorate": {
              "type": "boolean",
              "default": false
            }
          },
          "additionalProperties": false
        }
      ]
    },
    "selector": {
      "oneOf": [
        {
          "type": "object",
          "required": [
            "type"
          ],
          "properties": {
            "type": {
              "const": "ALWAYS"
            }
          },
          "additionalProperties": false
        },
        {
          "type": "object",
          "required": [
            "type",
            "source"
          ],
          "properties": {
            "type": {
              "const": "REFERENCE"
            },
            "source": {
              "type": "string"
            },
            "mapping": {
              "type": "object",
              "additionalProperties": {
                "type": "string"
              }
            }
          },
          "additionalProperties": false
        },
        {
          "type": "object",
          "required": [
            "type",
            "rules"
          ],
          "properties": {
            "type": {
              "const": "WEEKLY_SCHEDULE"
            },
            "timezone": {
              "type": "string"
            },
            "calendar": {
              "type": "string",
              "minLength": 1
            },
            "seasons": {
              "type": "array",
              "minItems": 1,
              "items": {
                "type": "object",
                "required": [
                  "id",
                  "from",
                  "to"
                ],
                "properties": {
                  "id": {
                    "type": "string",
                    "minLength": 1
                  },
                  "from": {
                    "type": "string",
                    "pattern": "^--(0[1-9]|1[0-2])-(0[1-9]|[12][0-9]|3[01])$"
                  },
                  "to": {
                    "type": "string",
                    "pattern": "^--(0[1-9]|1[0-2])-(0[1-9]|[12][0-9]|3[01])$"
                  }
                },
                "additionalProperties": false
              }
            },
            "rules": {
              "type": "array",
              "minItems": 1,
              "items": {
                "type": "object",
                "required": [
                  "zone",
                  "days"
                ],
                "properties": {
                  "zone": {
                    "type": "string"
                  },
                  "days": {
                    "type": "array",
                    "minItems": 1,
                    "items": {
                      "enum": [
                        "MON",
                        "TUE",
                        "WED",
                        "THU",
                        "FRI",
                        "SAT",
                        "SUN",
                        "HOLIDAY",
                        "mon",
                        "tue",
                        "wed",
                        "thu",
                        "fri",
                        "sat",
                        "sun",
                        "holiday"
                      ]
                    }
                  },
                  "season": {
                    "type": "string",
                    "minLength": 1
                  },
                  "priority": {
                    "type": "integer"
                  },
                  "from": {
                    "type": "string"
                  },
                  "to": {
                    "type": "string"
                  },
                  "time_ranges": {
                    "type": "array",
                    "minItems": 1,
                    "items": {
                      "type": "object",
                      "required": [
                        "from",
                        "to"
                      ],
                      "properties": {
                        "from": {
                          "type": "string"
                        },
                        "to": {
                          "type": "string"
                        }
                      },
                      "additionalProperties": false
                    }
                  }
                },
                "oneOf": [
                  {
                    "required": [
                      "from",
                      "to"
                    ],
                    "not": {
                      "required": [
                        "time_ranges"
                      ]
                    }
                  },
                  {
                    "required": [
                      "time_ranges"
                    ],
                    "not": {
                      "anyOf": [
                        {
                          "required": [
                            "from"
                          ]
                        },
                        {
                          "required": [
                            "to"
                          ]
                        }
                      ]
                    }
                  }
                ],
                "additionalProperties": false
              }
            }
          },
          "additionalProperties": false
        }
      ]
    },
    "rate": {
      "oneOf": [
        {
          "type": "object",
          "required": [
            "type",
            "value"
          ],
          "properties": {
            "type": {
              "const": "CONSTANT"
            },
            "value": {
              "type": [
                "string",
                "number"
              ]
            },
            "unit": {
              "type": "string"
            }
          },
          "additionalProperties": false
        },
        {
          "type": "object",
          "required": [
            "type",
            "rates"
          ],
          "properties": {
            "type": {
              "const": "ZONED"
            },
            "rates": {
              "type": "object",
              "additionalProperties": {
                "type": [
                  "string",
                  "number"
                ]
              }
            },
            "unit": {
              "type": "string"
            }
          },
          "additionalProperties": false
        },
        {
          "type": "object",
          "required": [
            "type",
            "source"
          ],
          "properties": {
            "type": {
              "const": "REFERENCE"
            },
            "source": {
              "type": "string"
            },
            "sourceUnit": {
              "type": "string"
            },
            "multiplier": {
              "type": [
                "string",
                "number"
              ],
              "default": "1"
            },
            "add": {
              "type": [
                "string",
                "number"
              ],
              "default": "0"
            },
            "unit": {
              "type": "string"
            }
          },
          "additionalProperties": false
        }
      ]
    },
    "billingCycle": {
      "type": "object",
      "properties": {
        "anchor": {
          "type": [
            "string",
            "null"
          ],
          "format": "date"
        },
        "length": {
          "type": "integer",
          "minimum": 1,
          "default": 1
        },
        "unit": {
          "enum": [
            "DAY",
            "WEEK",
            "MONTH",
            "YEAR"
          ],
          "default": "MONTH"
        }
      },
      "additionalProperties": false
    },
    "billingCyclePeriod": {
      "type": "object",
      "properties": {
        "validFrom": {
          "type": [
            "string",
            "null"
          ],
          "format": "date-time"
        },
        "validTo": {
          "type": [
            "string",
            "null"
          ],
          "format": "date-time"
        },
        "anchor": {
          "type": [
            "string",
            "null"
          ],
          "format": "date"
        },
        "length": {
          "type": "integer",
          "minimum": 1,
          "default": 1
        },
        "unit": {
          "enum": [
            "DAY",
            "WEEK",
            "MONTH",
            "YEAR"
          ],
          "default": "MONTH"
        }
      },
      "additionalProperties": false
    }
  }
}
