{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://supla.org/schema/energy-cost/cost-plan-v1.json",
  "title": "SUPLA Energy Cost Plan",
  "description": "User-owned cost-plan configuration. Preset identifiers are live references to package-managed tariff semantics; user values are persisted separately and the executable BillingDefinition is compiled from the current preset documents.",
  "type": "object",
  "required": [
    "version",
    "entries"
  ],
  "properties": {
    "version": {
      "const": 1
    },
    "entries": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/entry"
      }
    }
  },
  "additionalProperties": false,
  "$defs": {
    "entry": {
      "type": "object",
      "required": [
        "presetId",
        "values"
      ],
      "properties": {
        "validFrom": {
          "type": [
            "string",
            "null"
          ],
          "format": "date-time"
        },
        "validTo": {
          "type": [
            "string",
            "null"
          ],
          "format": "date-time"
        },
        "presetId": {
          "type": "string",
          "minLength": 1
        },
        "values": {
          "type": "object",
          "propertyNames": {
            "type": "string",
            "minLength": 1
          },
          "additionalProperties": {
            "type": [
              "string",
              "number"
            ]
          }
        }
      },
      "additionalProperties": false
    }
  }
}
