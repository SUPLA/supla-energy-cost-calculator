{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://supla.org/schema/energy-cost/frontend-tariff-preset-v1.json",
  "title": "SUPLA Frontend Tariff Preset",
  "type": "object",
  "required": [
    "version",
    "id",
    "label",
    "presetType",
    "components",
    "validFrom",
    "validTo",
    "currency",
    "timezone",
    "taxContext",
    "inputs",
    "billingDefinitionTemplate"
  ],
  "properties": {
    "version": {
      "const": 1
    },
    "id": {
      "type": "string",
      "minLength": 1
    },
    "label": {
      "type": "string",
      "minLength": 1
    },
    "presetType": {
      "enum": [
        "OFFER",
        "TARIFF",
        "GENERIC"
      ]
    },
    "components": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "object",
        "required": [
          "kind",
          "componentId",
          "label"
        ],
        "properties": {
          "kind": {
            "enum": [
              "ENERGY_PURCHASE",
              "DISTRIBUTION_VARIABLE",
              "DISTRIBUTION_FIXED",
              "SUPPLIER_FIXED"
            ]
          },
          "componentId": {
            "type": "string",
            "minLength": 1
          },
          "label": {
            "type": "string",
            "minLength": 1
          }
        },
        "additionalProperties": false
      }
    },
    "provider": {
      "$ref": "#/$defs/supplier"
    },
    "operator": {
      "type": "object",
      "required": [
        "id",
        "label"
      ],
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1
        },
        "label": {
          "type": "string",
          "minLength": 1
        }
      },
      "additionalProperties": false
    },
    "tariffGroup": {
      "type": "string",
      "minLength": 1
    },
    "validFrom": {
      "type": ["string", "null"],
      "format": "date-time"
    },
    "validTo": {
      "type": ["string", "null"],
      "format": "date-time"
    },
    "currency": {
      "const": "PLN"
    },
    "timezone": {
      "const": "Europe/Warsaw"
    },
    "taxContext": {
      "type": "object",
      "required": [
        "jurisdiction",
        "customerClass"
      ],
      "properties": {
        "jurisdiction": {
          "type": "string",
          "minLength": 1
        },
        "customerClass": {
          "type": "string",
          "minLength": 1
        }
      },
      "additionalProperties": false
    },
    "energyPurchase": {
      "$ref": "#/$defs/energyPurchase"
    },
    "sources": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["title", "url"],
        "properties": {
          "title": {"type": "string", "minLength": 1},
          "url": {"type": "string", "format": "uri"}
        },
        "additionalProperties": false
      }
    },
    "inputs": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/input"
      }
    },
    "billingDefinitionTemplate": {
      "$ref": "#/$defs/billingDefinitionTemplate"
    },
    "warnings": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "source": {
      "type": "object",
      "required": [
        "title",
        "url",
        "retrievedAt"
      ],
      "properties": {
        "title": {
          "type": "string",
          "minLength": 1
        },
        "url": {
          "type": "string",
          "format": "uri"
        },
        "retrievedAt": {
          "type": "string",
          "format": "date"
        }
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": false,
  "$defs": {
    "supplier": {
      "type": "object",
      "required": [
        "id",
        "label"
      ],
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1
        },
        "label": {
          "type": "string",
          "minLength": 1
        }
      },
      "additionalProperties": false
    },
    "input": {
      "type": "object",
      "required": [
        "id",
        "label",
        "type",
        "required",
        "targets"
      ],
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1
        },
        "label": {
          "type": "string",
          "minLength": 1
        },
        "type": {
          "enum": [
            "DECIMAL",
            "INTEGER",
            "DATE",
            "DATETIME",
            "TIME",
            "CHOICE"
          ]
        },
        "required": {
          "type": "boolean"
        },
        "targets": {
          "type": "array",
          "minItems": 1,
          "items": {
            "oneOf": [
              {"type": "string", "pattern": "^/"},
              {
                "type": "object",
                "required": ["pointer", "values"],
                "properties": {
                  "pointer": {"type": "string", "pattern": "^/"},
                  "values": {"type": "object"}
                },
                "additionalProperties": false
              }
            ]
          }
        },
        "unit": {
          "type": "string",
          "minLength": 1
        },
        "minimum": {
          "type": "integer"
        },
        "options": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "required": [
              "value",
              "label"
            ],
            "properties": {
              "value": {
                "type": "string",
                "minLength": 1
              },
              "label": {
                "type": "string",
                "minLength": 1
              }
            },
            "additionalProperties": false
          }
        },
        "help": {
          "type": "string",
          "minLength": 1
        }
      },
      "allOf": [
        {
          "if": {"properties": {"type": {"const": "CHOICE"}}},
          "then": {"required": ["options"]},
          "else": {"not": {"required": ["options"]}}
        }
      ],
      "additionalProperties": false
    },
    "source": {
      "type": "object",
      "required": [
        "title",
        "url",
        "retrievedAt"
      ],
      "properties": {
        "title": {
          "type": "string",
          "minLength": 1
        },
        "url": {
          "type": "string",
          "format": "uri"
        },
        "retrievedAt": {
          "type": "string",
          "format": "date"
        }
      },
      "additionalProperties": false
    },
    "energyPurchase": {
      "type": "object",
      "required": [
        "supplier",
        "sources"
      ],
      "properties": {
        "supplier": {
          "type": "object",
          "required": [
            "id",
            "label"
          ],
          "properties": {
            "id": {
              "type": "string",
              "minLength": 1
            },
            "label": {
              "type": "string",
              "minLength": 1
            }
          },
          "additionalProperties": false
        },
        "assumptions": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "sources": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/source"
          }
        }
      },
      "additionalProperties": false
    },
    "billingDefinitionTemplate": {
      "type": "object",
      "required": [
        "periods"
      ],
      "properties": {
        "periods": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "required": [
              "components"
            ],
            "properties": {
              "components": {
                "type": "array",
                "minItems": 1,
                "items": {
                  "$ref": "#/$defs/executableComponent"
                }
              }
            },
            "additionalProperties": true
          }
        }
      },
      "additionalProperties": true
    },
    "executableComponent": {
      "type": "object",
      "required": [
        "id",
        "kind",
        "taxTreatment"
      ],
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1
        },
        "kind": {
          "enum": [
            "ENERGY_PURCHASE",
            "DISTRIBUTION_VARIABLE",
            "DISTRIBUTION_FIXED",
            "SUPPLIER_FIXED"
          ]
        },
        "taxTreatment": {
          "type": "object",
          "required": [
            "included"
          ],
          "properties": {
            "included": {
              "type": "array",
              "items": {
                "enum": [
                  "EXCISE",
                  "VAT"
                ]
              },
              "uniqueItems": true
            }
          },
          "additionalProperties": false
        }
      },
      "additionalProperties": true
    }
  }
}
