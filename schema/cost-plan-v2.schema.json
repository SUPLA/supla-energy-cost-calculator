{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://supla.org/schema/energy-cost/cost-plan-v2.json",
  "title": "SUPLA component cost plan",
  "type": "object",
  "required": ["version", "currency", "timezone", "priceBasis", "billingCycles", "periods"],
  "properties": {
    "version": {"const": 2},
    "currency": {"type": "string", "minLength": 1},
    "timezone": {"type": "string", "minLength": 1},
    "priceBasis": {"enum": ["NET", "GROSS"]},
    "billingCycles": {
      "type": "array", "minItems": 1,
      "items": {
        "type": "object", "required": ["length", "unit"],
        "properties": {
          "validFrom": {"type": ["string", "null"], "format": "date-time"},
          "validTo": {"type": ["string", "null"], "format": "date-time"},
          "anchor": {"type": ["string", "null"], "format": "date"},
          "length": {"type": "integer", "minimum": 1},
          "unit": {"enum": ["DAY", "WEEK", "MONTH", "YEAR"]}
        }, "additionalProperties": false
      }
    },
    "periods": {
      "type": "array", "minItems": 1,
      "items": {
        "type": "object", "required": ["components"],
        "properties": {
          "validFrom": {"type": ["string", "null"], "format": "date-time"},
          "validTo": {"type": ["string", "null"], "format": "date-time"},
          "components": {
            "type": "array", "minItems": 1,
            "items": {"oneOf": [
              {
                "type": "object", "required": ["kind", "presetId", "componentId", "values"],
                "properties": {
                  "kind": {"enum": ["ENERGY_PURCHASE", "DISTRIBUTION_VARIABLE", "DISTRIBUTION_FIXED", "SUPPLIER_FIXED"]},
                  "presetId": {"type": "string", "minLength": 1},
                  "componentId": {"type": "string", "minLength": 1},
                  "values": {
                    "type": "object", "propertyNames": {"type": "string", "minLength": 1},
                    "additionalProperties": {"type": ["string", "number"]}
                  }
                },
                "additionalProperties": false
              },
              {
                "type": "object", "required": ["kind", "rate", "per"],
                "properties": {
                  "kind": {"enum": ["DISTRIBUTION_FIXED", "SUPPLIER_FIXED"]},
                  "rate": {"type": "string", "pattern": "^-?(?:0|[1-9][0-9]*)(?:\\.[0-9]+)?$"},
                  "per": {"enum": ["DAY", "WEEK", "MONTH", "YEAR", "BILLING_PERIOD"]},
                  "prorate": {"type": "boolean"}
                }, "additionalProperties": false
              }
            ]}
          }
        }, "additionalProperties": false
      }
    }
  }, "additionalProperties": false
}
